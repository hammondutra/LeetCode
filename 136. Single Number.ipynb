   "source": [
    "class Solution:\n",
    "    def singleNumber(self, nums: List[int]) -> int:\n",
    "        total = 0\n",
    "\n",
    "        for num in nums:\n",
    "            total ^= num\n",
    "        \n",
    "        return total"
   ]
  }

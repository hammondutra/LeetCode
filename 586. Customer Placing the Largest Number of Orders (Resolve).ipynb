   "source": [
    "# Write your MySQL query statement below\n",
    "SELECT customer_number\n",
    "FROM Orders\n",
    "GROUP BY customer_number\n",
    "HAVING COUNT(*) = (\n",
    "    SELECT MAX(order_count)\n",
    "    FROM (\n",
    "        SELECT COUNT(*) as order_count\n",
    "        FROM Orders\n",
    "        GROUP BY customer_number\n",
    "    ) AS customer_count\n",
    ");"
   ]
  }

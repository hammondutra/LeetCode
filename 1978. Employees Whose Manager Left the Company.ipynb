    "SELECT employee_id\n",
    "FROM Employees\n",
    "    \n",
    "WHERE salary < 30000\n",
    "    AND manager_id IS NOT NULL\n",
    "    AND manager_id NOT IN (\n",
    "        SELECT employee_id\n",
    "        FROM Employees\n",
    "    )\n",
    "ORDER BY employee_id;"

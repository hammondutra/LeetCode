    "# Write your MySQL query statement below\n",
    "SELECT\n",
    "    Person.firstName, \n",
    "    Person.lastName,\n",
    "    Address.city,\n",
    "    Address.state\n",
    "FROM Person\n",
    "LEFT JOIN Address\n",
    "    ON Person.personID = Address.personID;"

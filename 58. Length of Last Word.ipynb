   "source": [
    "class Solution:\n",
    "    def lengthOfLastWord(self, s: str) -> int:\n",
    "        length = 0\n",
    "\n",
    "        for i in range(len(s) - 1, -1, -1):\n",
    "            if s[i] != ' ':\n",
    "                length += 1\n",
    "            elif length > 0:\n",
    "                return length\n",
    "        \n",
    "        return length"
   ]
  }
 ],

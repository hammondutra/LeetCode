    "# Write your MySQL query statement below\n",
    "SELECT employee.name as Employee\n",
    "FROM Employee as employee\n",
    "JOIN Employee as manager\n",
    "    ON employee.managerId = manager.id\n",
    "WHERE\n",
    "    employee.salary > manager.salary;"
